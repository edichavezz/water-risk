# Copy to .env.local and fill in values

# Server-side only — used by /api/interpret (Vercel function or Vite dev
# middleware). NOT exposed to the browser: it has no VITE_ prefix, so Vite
# never bundles it into client code.
ANTHROPIC_API_KEY=sk-ant-...

# Optional override; defaults to claude-haiku-4-5
# ANTHROPIC_MODEL=claude-haiku-4-5

# Optional — for AEMET climate data (free registration at opendata.aemet.es)
VITE_AEMET_API_KEY=
